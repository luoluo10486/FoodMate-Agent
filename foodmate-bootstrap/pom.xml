<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.foodmate</groupId>
    <artifactId>foodmate</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>foodmate-bootstrap</artifactId>
  <name>FoodMate Bootstrap</name>

  <dependencies>
    <dependency>
      <!-- 启动模块直接声明并创建 MinioClient，开发期 spring-boot:run 也必须取得该运行时类。 -->
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
      <version>8.2.2</version>
    </dependency>
    <dependency>
      <groupId>com.foodmate</groupId>
      <artifactId>foodmate-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.foodmate</groupId>
      <artifactId>foodmate-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.foodmate</groupId>
      <artifactId>foodmate-gateway-client</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.foodmate</groupId>
      <artifactId>foodmate-infra</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.foodmate</groupId>
      <artifactId>foodmate-shared</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

