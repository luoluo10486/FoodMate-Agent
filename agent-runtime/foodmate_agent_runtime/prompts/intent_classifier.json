    "output_contract": {
      "format": "只返回 JSON 对象；不要使用 Markdown、代码围栏或额外解释。",
      "exact_root_keys": ["status", "intents", "missing_slots", "clarification_question", "reason_code", "classifier_version"],
      "status": "只能使用 ready 或 needs_clarification。ready 表示意图明确；needs_clarification 表示需要用户补充信息。",
      "intents": {
        "max_items": 3,
        "exact_item_keys": ["name", "confidence", "entities"],
        "name": ["calculation", "analysis", "planning", "record", "knowledge_qna"],
        "confidence": "取值范围为 0 到 1 的 JSON 数字。",
        "entities_exact_keys": ["metric", "food_name", "time_range", "meal_type", "operation", "days"],
        "entity_values": "最多 100 个字符的字符串，或 null。"
      },
      "missing_slots": {"max_items": 8, "allowed_values": ["intent", "time_range", "food_name", "meal_type", "amount", "unit", "days", "details"]},
      "clarification_question": "ready 时必须为 null；需要澄清时填写一个不超过 300 个字符的简短中文问题。",
      "reason_code": ["CALCULATION_REQUEST", "STRUCTURED_DATA_ANALYSIS", "PLAN_REQUEST", "FOOD_LOG_MUTATION", "GENERAL_KNOWLEDGE_QUESTION", "AMBIGUOUS_INTENT", "MULTIPLE_INTENTS", "LOW_CONFIDENCE", "INSUFFICIENT_CONTEXT"],
      "classifier_version": "intent-v1",
      "ready_invariant": "必须恰好包含一个意图，confidence 不低于 0.65，missing_slots 为空，clarification_question 为 null。",
      "clarification_invariant": "必须包含至少一个 missing_slot 和非空的 clarification_question；多个意图、请求冲突、置信度过低或上下文不足时使用此状态。"
    },
    "user_message": null,
    "conversation_context": []
  }
}
