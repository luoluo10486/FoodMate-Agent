# Copy to ../.env or docker/.env for local use. Never commit real secrets.
TZ=Asia/Shanghai

# PostgreSQL
POSTGRES_DB=FoodMate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/FoodMate
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_PASSWORD=foodmate-redis-change-me
# 宿主机 6379 可能被其他 Redis 服务占用；FoodMate 可改用独立端口。
REDIS_PORT=6380
REDIS_URL=redis://:foodmate-redis-change-me@localhost:6380

# MinIO (private bucket)
MINIO_ROOT_USER=foodmate-local
MINIO_ROOT_PASSWORD=foodmate-minio-change-me
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=foodmate-local
MINIO_SECRET_KEY=foodmate-minio-change-me
MINIO_BUCKET=foodmate-private
MINIO_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PRESIGN_TTL_SECONDS=300

# Password reset links
FOODMATE_WEB_BASE_URL=http://localhost:5173

# RocketMQ（ADR-0005 异步主通道，本地单 NameServer + 单 Broker）
# Topic 名只允许 ^[%|a-zA-Z0-9_-]+$，不能使用点号。
ROCKETMQ_IMAGE=apache/rocketmq:5.2.0
ROCKETMQ_PROXY_ADDR=localhost:8081
ROCKETMQ_PROXY_GRPC_PORT=8081
ROCKETMQ_PROXY_REMOTING_PORT=8080
ROCKETMQ_VERSION=5.2.0
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_VIP_PORT=10909
FOODMATE_ROCKETMQ_NAMESRV_ADDR=localhost:9876
FOODMATE_ROCKETMQ_TOPIC_AGENT_COMMAND=foodmate-agent-command-v1
FOODMATE_ROCKETMQ_TOPIC_AGENT_EVENT=foodmate-agent-event-v1
FOODMATE_ROCKETMQ_TOPIC_AGENT_PROPOSAL=foodmate-agent-proposal-v1
FOODMATE_ROCKETMQ_TOPIC_AGENT_RESULT=foodmate-agent-result-v1
FOODMATE_ROCKETMQ_CONSUMER_GROUP_JAVA_AGENT_EVENT=foodmate-java-agent-event-v1
FOODMATE_ROCKETMQ_CONSUMER_GROUP_JAVA_AGENT_PROPOSAL=foodmate-java-agent-proposal-v1
FOODMATE_ROCKETMQ_CONSUMER_GROUP_PYTHON_AGENT_COMMAND=foodmate-python-agent-command-v1
FOODMATE_ROCKETMQ_CONSUMER_GROUP_PYTHON_AGENT_RESULT=foodmate-python-agent-result-v1
